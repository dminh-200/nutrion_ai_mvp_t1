# Nhà cung cấp và chế độ LLM
LLM_PROVIDER=gemini
LLM_MODE=real
LLM_MAX_RPM=8
LLM_CACHE_DIR=.cache/llm

# Gemini (mặc định theo SPEC)
GEMINI_API_KEY=
GEMINI_PLANNER_MODEL=gemini-3.8-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite

# Groq (tùy chọn khi LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Alibaba Cloud Model Studio - OpenAI Compatible (tùy chọn khi LLM_PROVIDER=alibaba)
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://ws-rkodq3wgmou33rdz.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=qwen3.8-flash

# Công cụ và Guardrails
TOOLS_MODE=mcp
SAFETY_LLM=off

# Observability (Langfuse v5 - để trống để tắt tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Dữ liệu và RAG cục bộ
DB_URL=sqlite:///db/nutrition.db
CHECKPOINT_DB=db/checkpoints.sqlite
CHROMA_DIR=rag/chroma
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_MIN_SCORE=0.2
APP_ENV=dev
