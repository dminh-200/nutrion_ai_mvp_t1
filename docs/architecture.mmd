    MCP --> RAG["Tầng Tri thức (RAG)<br/>rag/retrieve.py, ingest.py, embeddings.py"]
    GW -.->|"direct mode"| CORE
    GW -.->|"direct mode"| RAG

    CORE --> DB[("SQLite + SQLAlchemy 2.x<br/>db/nutrition.db & checkpoints.sqlite")]
    RAG --> CHROMA[("ChromaDB PersistentClient<br/>rag/chroma/")]
